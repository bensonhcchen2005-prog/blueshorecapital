# Moomoo Trading System Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# === OpenD Gateway ===
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# === Moomoo Account ===
# Only needed for live trading — paper trading works without unlock
MOOMOO_TRADE_PASSWORD=

# === Trading Mode ===
# CRITICAL: Keep this False until you've validated with paper trading
LIVE_TRADING_ENABLED=False
TRADING_MARKET=US

# === Risk Limits ===
MAX_POSITION_SIZE_PCT=0.05
MAX_POSITION_SIZE_USD=5000
MAX_DAILY_LOSS_PCT=0.02
MAX_OPEN_TRADES=5
MAX_TICKER_CONCENTRATION=0.10
COOLDOWN_AFTER_CONSECUTIVE_LOSSES=3
COOLDOWN_DURATION_MINUTES=30
MIN_VOLUME_FILTER=500000
MAX_SPREAD_PCT=0.005

# === Logging ===
LOG_LEVEL=INFO
LOG_DIR=logs
